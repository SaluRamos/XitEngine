{
    "version": 3,
    "configurePresets": [
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/out/build/gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ]
}